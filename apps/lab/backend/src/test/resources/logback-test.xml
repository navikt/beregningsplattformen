<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="json"/>
    </root>

    <logger name="appLog"    level="INFO" additivity="false"><appender-ref ref="json"/></logger>
    <logger name="secureLog" level="TRACE" additivity="false"><appender-ref ref="json"/></logger>
    <logger name="audit"     level="INFO" additivity="false"><appender-ref ref="json"/></logger>
    <logger name="http"      level="INFO" additivity="false"><appender-ref ref="json"/></logger>
</configuration>

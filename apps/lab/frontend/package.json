{
  "name": "beregningsplattformen-lab-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:backend": "vite --mode backend",
    "build": "tsc && vite build",
    "biome:check": "biome check --files-ignore-unknown=true",
    "biome:fix": "biome check --write --no-errors-on-unmatched",
    "stylelint:check": "stylelint '**/*.css'",
    "stylelint:fix": "stylelint '**/*.css' --fix",
    "prepare": "husky",
    "pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
  },
  "dependencies": {
    "@nais/apm": "0.7.3",
    "@navikt/aksel-icons": "8.19.1",
    "@navikt/ds-css": "8.19.1",
    "@navikt/ds-react": "8.19.1",
		"axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "swr": "2.5.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@navikt/aksel-stylelint": "8.19.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "@navikt/aksel-stylelint/recommended"
    ],
    "rules": {
      "selector-class-pattern": "^[a-z][a-z0-9-]*(__[a-z][a-z0-9-]*)*(--[a-z][a-z0-9-]*)?$",
      "custom-property-pattern": "[a-z][a-zA-Z0-9-]+"
    }
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
    "*.css": "stylelint --fix"
  },
  "engines": {
    "pnpm": ">=11.28.5",
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
